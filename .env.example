# Copy this file to .env and fill in real values for local development.
# Never commit the actual .env file. See AGENTS.md "Data Handling" and
# ARCHITECTURE.md §22 "Configuration".

# --- Django ---
DJANGO_SECRET_KEY=changeme-generate-a-real-secret-key-for-any-non-local-use
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# --- Database (PostgreSQL, docker-compose service name "postgres") ---
DATABASE_URL=postgres://agentfw:agentfw_dev_password@localhost:5432/agent_action_firewall

# --- Redis (docker-compose service name "redis") ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (comma-separated list; never use "*" for authenticated endpoints) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Request limits ---
DATA_UPLOAD_MAX_MEMORY_SIZE=1048576
