# Gemini (Google AI Studio free tier)
GEMINI_API_KEY=

# Optional overrides for the buyer agent
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_REMOTE_CALLS=4
GEMINI_CALL_SPACING_SECONDS=15

# Razorpay test-mode credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CHECKOUT_CONFIG_ID=

# Cryptographic mandate signing (generated via `python manage.py generate_mandate_keys`)
MANDATE_PRIVATE_KEY=
MANDATE_PUBLIC_KEY=
MANDATE_KEY_ID=

# Demo agent (printed fresh every time you run `python manage.py seed_demo_agent` - re-copy each run)
DEMO_AGENT_TOKEN=
DEMO_TASK_ID=demo-buyer-task

# Site base URL (used by the buyer agent and Agent Console to build checkout/status URLs)
SITE_BASE_URL=http://127.0.0.1:8000